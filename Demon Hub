    exitESP = false, questItem = false, vehicle = false, aiChams = false,
    -- Visual
    noGlass = false, fullbright = false,
    -- Settings
    fovTrans = 50, textSize = 11, uiScale = 100, showFPS = false, crosshair = false,
    -- Cheater/Admin ESP
    adminESP = false, cheaterESP = false, adminColor = Color3.fromRGB(255, 0, 0),
    cheaterColor = Color3.fromRGB(255, 165, 0),
    -- Cores Fixas
    colorTheme = Color3.fromRGB(255, 40, 60),
    colorBg = Color3.fromRGB(15, 10, 12),
}

local function saveConfig()
    if not hasFileIO then return end
    pcall(function()
        local serial = {}
        for k, v in pairs(State) do
            if typeof(v) == "Color3" then serial[k] = { __c = true, r = v.R, g = v.G, b = v.B }
            else serial[k] = v end
        end
        writefile(CONFIG_FILE, HttpService:JSONEncode(serial))
    end)
end

local function loadConfig()
    if not hasFileIO then return end
    pcall(function()
        if isfile and isfile(CONFIG_FILE) then
            local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
            for k, v in pairs(data) do
                if type(v) == "table" and v.__c then State[k] = Color3.new(v.r, v.g, v.b)
                else State[k] = v end
            end
        end
    end)
end
loadConfig()

