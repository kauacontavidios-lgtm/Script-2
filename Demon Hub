local function addToggle(page, key, label)
    local b = makeButton(
        page, "", UDim2.new(1, -4, 0, 34), UDim2.new()
    )
    b.TextXAlignment = Enum.TextXAlignment.Left

    local function render()
        b.Text = (S[key] and "  [ON]   " or "  [OFF]  ") .. label
        b.BackgroundColor3 = S[key] and Color3.fromRGB(85, 12, 30) or ROW
    end

    b.Activated:Connect(function()
        S[key] = not S[key]
        render()
    end)

    controls[key] = render
    render()
end

local function addSlider(page, key, label, min, max)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -4, 0, 64)
    holder.BackgroundColor3 = ROW
    holder.BorderSizePixel = 0
    holder.Parent = page
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 6)

    local text = Instance.new("TextLabel")
    text.Position = UDim2.fromOffset(8, 2)
    text.Size = UDim2.new(1, -16, 0, 22)
    text.BackgroundTransparency = 1
    text.TextColor3 = WHITE
    text.Font = Enum.Font.Gotham
    text.TextSize = 13
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.Parent = holder

    local track = Instance.new("TextButton")
    track.Position = UDim2.fromOffset(8, 38)
    track.Size = UDim2.new(1, -16, 0, 12)
    track.BackgroundColor3 = Color3.fromRGB(55, 35, 43)
    track.Text = ""
    track.Parent = holder
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = RED
    fill.BorderSizePixel = 0
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local dragging = false

    local function update(x)
        local alpha = math.clamp(
            (x - track.AbsolutePosition.X) /
            math.max(track.AbsoluteSize.X, 1), 0, 1
        )
        S[key] = math.floor(min + alpha * (max - min) + 0.5)
        fill.Size = UDim2.new((S[key] - min) / (max - min), 0, 1, 0)
        text.Text = label .. ": " .. S[key]
    end

    track.Activated:Connect(function()
        update(UIS:GetMouseLocation().X)
    end)

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            update(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    controls[key] = function()
        fill.Size = UDim2.new((S[key] - min) / (max - min), 0, 1, 0)
        text.Text = label .. ": " .. S[key]
    end

    controls[key]()
end

