local function toggle(page, labelText, key)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 38)
    button.BackgroundColor3 = DARK
    button.Text = ""
    button.Parent = page
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 5)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -65, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = WHITE
    label.TextSize = 13
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = button

    local state = Instance.new("TextLabel")
    state.Size = UDim2.new(0, 42, 0, 23)
    state.Position = UDim2.new(1, -50, 0.5, -11)
    state.BorderSizePixel = 0
    state.Text = ""
    state.Parent = button
    Instance.new("UICorner", state).CornerRadius = UDim.new(1, 0)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 17, 0, 17)
    dot.Position = UDim2.new(0, 3, 0.5, -8)
    dot.BackgroundColor3 = WHITE
    dot.Parent = state
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    local function update()
        state.BackgroundColor3 =
            settings[key] and RED or Color3.fromRGB(55, 55, 68)
        dot.Position = settings[key]
            and UDim2.new(1, -20, 0.5, -8)
            or UDim2.new(0, 3, 0.5, -8)
    end

    button.Activated:Connect(function()
        settings[key] = not settings[key]
        update()
    end)

    update()
end

local function slider(page, labelText, key, minimum, maximum)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 62)
    frame.BackgroundColor3 = DARK
    frame.Parent = page
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 5)

    local label = Instance.new("TextLabel")
    label.Position = UDim2.new(0, 9, 0, 3)
    label.Size = UDim2.new(1, -18, 0, 23)
    label.BackgroundTransparency = 1
    label.TextColor3 = WHITE
    label.TextSize = 13
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local track = Instance.new("TextButton")
    track.Position = UDim2.new(0, 10, 0, 36)
    track.Size = UDim2.new(1, -20, 0, 14)
    track.BackgroundColor3 = Color3.fromRGB(55, 35, 43)
    track.Text = ""
    track.Parent = frame
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = RED
    fill.BorderSizePixel = 0
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local dragging = false

    local function setValue(x)
        local ratio = math.clamp(
            (x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1
        )
        settings[key] = math.floor(minimum + ratio * (maximum - minimum) + 0.5)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        label.Text = labelText .. ": " .. settings[key]
    end

    local function update()
        local ratio = (settings[key] - minimum) / (maximum - minimum)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        label.Text = labelText .. ": " .. settings[key]
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setValue(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            setValue(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    update()
end

