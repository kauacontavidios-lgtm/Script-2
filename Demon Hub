-- 4. LÓGICA DE DETECÇÃO (CHEATER / ADMIN)
-- ============================================================
local KNOWN_ADMINS = {} -- Adicione nomes de admins conhecidos aqui se quiser
local KNOWN_CHEATERS = {} -- Adicione nomes de cheaters conhecidos aqui se quiser

local function isAdmin(plr)
    if table.find(KNOWN_ADMINS, plr.Name) then return true end
    -- Verifica se o jogador está em um grupo de administração comum no Roblox
    local success, rank = pcall(function() return plr:GetRankInGroup(1234567) end) -- Substitua pelo ID do grupo do jogo
    if success and rank >= 200 then return true end
    -- Verifica tags suspeitas no nome
    local lowerName = plr.Name:lower()
    if lowerName:find("admin") or lowerName:find("mod") or lowerName:find("owner") then return true end
    return false
end

local function isCheater(plr)
    if table.find(KNOWN_CHEATERS, plr.Name) then return true end
    -- Checagem heurística básica: velocidade absurda
    local char = plr.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed > 50 then return true end
    end
    return false
end

-- ============================================================
-- 5. LÓGICA DE ESP (RENDER)
-- ============================================================
local ESPStore = {}
local renderConnection

local function updateESP()
    if not workspace.CurrentCamera then return end
    local cam = workspace.CurrentCamera
    
    for _, plr in ipairs(Players:GetPlayers()) do
        local isLocal = (plr == LocalPlayer)
        local isTeam = State.teamCheck and plr.Team == LocalPlayer.Team
        
        if isLocal or isTeam or not plr.Character then
            if ESPStore[plr] then
                for _, d in pairs(ESPStore[plr]) do pcall(function() d:Remove() end) end
                ESPStore[plr] = nil
            end
            continue
        end
        
        local char = plr.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if not hrp or not head or not hum or hum.Health <= 0 then
            if ESPStore[plr] then
                for _, d in pairs(ESPStore[plr]) do pcall(function() d:Remove() end) end
                ESPStore[plr] = nil
            end
            continue
        end
        
        local dist = (cam.CFrame.Position - hrp.Position).Magnitude
        if dist > State.maxDist then
            if ESPStore[plr] then
                for _, d in pairs(ESPStore[plr]) do d.Visible = false end
            end
            continue
        end
        
        -- Verifica Admin / Cheater
        local plrIsAdmin = State.adminESP and isAdmin(plr)
        local plrIsCheater = State.cheaterESP and isCheater(plr)
        local alertType = plrIsAdmin and "ADMIN" or (plrIsCheater and "CHEATER" or nil)
        local alertColor = plrIsAdmin and State.adminColor or State.cheaterColor
        
        if not ESPStore[plr] then
            ESPStore[plr] = {
                box = Drawing.new("Square"),
                name = Drawing.new("Text"),
                healthBar = Drawing.new("Line"),
                distText = Drawing.new("Text"),
                alertText = Drawing.new("Text"),
                skeleton = {}
            }
            ESPStore[plr].box.Thickness = 1
            ESPStore[plr].box.Color = State.colorTheme
            ESPStore[plr].name.Size = State.textSize
            ESPStore[plr].name.Center = true
            ESPStore[plr].name.Color = Color3.fromRGB(255, 255, 255)
            ESPStore[plr].healthBar.Thickness = 2
            ESPStore[plr].healthBar.Color = Color3.fromRGB(0, 255, 0)
            ESPStore[plr].distText.Size = State.textSize
            ESPStore[plr].distText.Center = true
            ESPStore[plr].distText.Color = State.colorTheme
            ESPStore[plr].alertText.Size = State.textSize + 2
            ESPStore[plr].alertText.Center = true
        end
        
        local e = ESPStore[plr]
        local headPos, headOn = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local rootPos, rootOn = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 1.5, 0))
        
        if headOn and rootOn then
            local h = math.abs(rootPos.Y - headPos.Y)
            local w = h * 0.55
            local x = headPos.X - w / 2
            local y = headPos.Y
            
            -- Box (Muda de cor se for Admin/Cheater)
            e.box.Visible = State.boxESP or plrIsAdmin or plrIsCheater
            if e.box.Visible then
                e.box.Size = Vector2.new(w, h)
                e.box.Position = Vector2.new(x, y)
                if plrIsAdmin then e.box.Color = State.adminColor
                elseif plrIsCheater then e.box.Color = State.cheaterColor
                else e.box.Color = State.colorTheme end
                e.box.Thickness = (plrIsAdmin or plrIsCheater) and 2 or 1
            end
            
            -- Alerta Admin/Cheater
            e.alertText.Visible = alertType ~= nil
            if e.alertText.Visible then
                e.alertText.Text = "[" .. alertType .. "]"
                e.alertText.Position = Vector2.new(x + w / 2, y - State.textSize - 20)
                e.alertText.Color = alertColor
            end

            -- Name
            e.name.Visible = State.nameTag and not alertType
            if e.name.Visible then
                e.name.Text = plr.Name
                e.name.Position = Vector2.new(x + w / 2, y - State.textSize - 5)
            end
            
            -- Health
            e.healthBar.Visible = State.healthBar
            if State.healthBar then
                local hpPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                e.healthBar.From = Vector2.new(x + w + 4, y + h - h * hpPct)
                e.healthBar.To = Vector2.new(x + w + 4, y + h)
            end
            
            -- Distance
            e.distText.Visible = State.distESP
            if State.distESP then
                e.distText.Text = string.format("[%dm]", math.floor(dist))
                e.distText.Position = Vector2.new(x + w / 2, y + h + 5)
            end
            
            -- Skeleton
            if State.skelESP then
                local bones = {"Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "RightUpperArm", "RightLowerArm", "LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg"}
                local pts = {}
                for _, bName in ipairs(bones) do
                    local b = char:FindFirstChild(bName)
                    if b then
                        local sp, on = cam:WorldToViewportPoint(b.Position)
                        if on then pts[bName] = sp end
                    end
                end
                local conns = {
                    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
                    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},
                    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},
                    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},
                    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"}
                }
                local idx = 1
                for _, c in ipairs(conns) do
                    if pts[c[1]] and pts[c[2]] then
                        if not e.skeleton[idx] then
                            e.skeleton[idx] = Drawing.new("Line")
                            e.skeleton[idx].Color = (plrIsAdmin and State.adminColor) or (plrIsCheater and State.cheaterColor) or State.colorTheme
                            e.skeleton[idx].Thickness = 1
                        end
                        e.skeleton[idx].Visible = true
                        e.skeleton[idx].From = pts[c[1]]
                        e.skeleton[idx].To = pts[c[2]]
                        idx = idx + 1
                    end
                end
                for i = idx, #e.skeleton do e.skeleton[i].Visible = false end
            else
                for _, line in pairs(e.skeleton) do line.Visible = false end
            end
        else
            e.box.Visible = false; e.name.Visible = false; e.healthBar.Visible = false
            e.distText.Visible = false; e.alertText.Visible = false
            for _, line in pairs(e.skeleton) do line.Visible = false end
        end
    end
end

renderConnection = RunService.RenderStepped:Connect(function()
    pcall(updateESP)
end)

