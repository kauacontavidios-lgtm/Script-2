
-- DEMON HUB | Server | Save / Load Config
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")

local store = DataStoreService:GetDataStore("DemonHub_v2")

local remote = ReplicatedStorage:FindFirstChild("DemonHubConfig")
if not remote then
    remote = Instance.new("RemoteFunction")
    remote.Name = "DemonHubConfig"
    remote.Parent = ReplicatedStorage
end

local defaults = {
    ESP = false,
    NameTag = true,
    HealthBar = true,
    Distance = true,
    Aimbot = false,
    ShowFOV = true,
    NPCESP = false,
    MaxDistance = 1200,
    FOV = 120,
    Smoothness = 5,
    FOVTransparency = 50,
    ESPTextSize = 11,
}

local limits = {
    MaxDistance = {100, 1200},
    FOV = {10, 300},
    Smoothness = {1, 20},
    FOVTransparency = {0, 100},
    ESPTextSize = {8, 24},
}

local function sanitize(data)
    if type(data) ~= "table" then return nil end
    local result = {}

    for key, default in pairs(defaults) do
        local value = data[key]

        if type(value) ~= type(default) then
            value = default
        end

        if type(value) == "number" then
            if value ~= value or math.abs(value) == math.huge then
                value = default
            end
            if limits[key] then
                value = math.clamp(
                    value, limits[key][1], limits[key][2]
                )
            end
        end

        result[key] = value
    end

    return result
end

remote.OnServerInvoke = function(player, action, name, data)
    if type(name) ~= "string"
        or #name < 1
        or #name > 30
        or not name:match("^[%w _%-]+$") then
        return false, "Nome inválido."
    end

    local key = "player_" .. player.UserId .. "_" .. name

    if action == "Save" then
        local clean = sanitize(data)
        if not clean then return false, "Config inválida." end

        local ok, err = pcall(function()
            store:SetAsync(key, clean)
        end)

        if not ok then
            warn("Demon Hub save:", err)
            return false, "Erro ao salvar. Verifique o DataStore."
        end

        return true, "Config salva!"
    end

    if action == "Load" then
        local ok, result = pcall(function()
            return store:GetAsync(key)
        end)

        if not ok then return false, "Erro ao carregar." end
        if not result then return false, "Config não encontrada." end

        return true, "Config carregada!", sanitize(result)
    end

    return false, "Ação inválida."
end

