local function section(page, text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -4, 0, 26)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = RED
    label.TextSize = 15
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = page
end

local function addToggle(page, key, label)
    local b = button(
        page, "", UDim2.new(1, -4, 0, 34), UDim2.new()
    )
    b.TextXAlignment = Enum.TextXAlignment.Left

    local function draw()
        b.Text = (S[key] and "  [ON]   " or "  [OFF]  ") .. label
        b.BackgroundColor3 = S[key]
            and Color3.fromRGB(75, 13, 30) or ROW
    end

    b.Activated:Connect(function()
        S[key] = not S[key]
        draw()
    end)

    refresh[key] = draw
    draw()
end

local function addSlider(page, key, label, min, max)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -4, 0, 58)
    holder.BackgroundColor3 = ROW
    holder.BorderSizePixel = 0
    holder.Parent = page
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 6)

    local caption = Instance.new("TextLabel")
    caption.Position = UDim2.fromOffset(8, 2)
    caption.Size = UDim2.new(1, -16, 0, 22)
    caption.BackgroundTransparency = 1
    caption.TextColor3 = WHITE
    caption.TextSize = 12
    caption.Font = Enum.Font.Gotham
    caption.TextXAlignment = Enum.TextXAlignment.Left
    caption.Parent = holder

    local track = Instance.new("TextButton")
    track.Position = UDim2.fromOffset(8, 34)
    track.Size = UDim2.new(1, -16, 0, 12)
    track.BackgroundColor3 = Color3.fromRGB(60, 40, 46)
    track.Text = ""
    track.Parent = holder
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = RED
    fill.BorderSizePixel = 0
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local function draw()
        local ratio = (S[key] - min) / (max - min)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        caption.Text = label .. ": " .. tostring(S[key])
    end

    local dragging = false

    local function setFromX(x)
        local width = math.max(track.AbsoluteSize.X, 1)
        local ratio = math.clamp(
            (x - track.AbsolutePosition.X) / width, 0, 1
        )
        S[key] = math.floor(min + ratio * (max - min) + 0.5)
        draw()
    end

    track.Activated:Connect(function()
        setFromX(UIS:GetMouseLocation().X)
    end)

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            setFromX(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    refresh[key] = draw
    draw()
end

