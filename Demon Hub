local nameBox = Instance.new("TextBox")
nameBox.Size = UDim2.new(1, -4, 0, 34)
nameBox.BackgroundColor3 = ROW
nameBox.TextColor3 = WHITE
nameBox.PlaceholderText = "Enter Config Name"
nameBox.Text = ""
nameBox.ClearTextOnFocus = false
nameBox.Font = Enum.Font.Gotham
nameBox.TextSize = 13
nameBox.Parent = settingsPage

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -4, 0, 24)
status.BackgroundTransparency = 1
status.Text = "Ready"
status.TextColor3 = RED
status.TextSize = 12
status.Parent = settingsPage

local function configAction(action)
    if nameBox.Text == "" then
        status.Text = "Digite um nome para a config."
        return
    end

    status.Text = "Aguarde..."

    local ok, success, message, data = pcall(function()
        return remote:InvokeServer(action, nameBox.Text, S)
    end)

    if not ok then
        status.Text = "Configure o script do servidor."
        return
    end

    status.Text = message or "Concluído."

    if action == "Load" and success and type(data) == "table" then
        for key, value in pairs(data) do
            if S[key] ~= nil and type(S[key]) == type(value) then
                S[key] = value
            end
        end

        for _, draw in pairs(refresh) do
            draw()
        end
    end
end

