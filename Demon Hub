local function section(col, title)
    local box = new("Frame", {
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundColor3 = C.panel,
        AutomaticSize = Enum.AutomaticSize.None
    }, col)
    corner(box, 6)
    stroke(box, C.red, 1)

    new("TextLabel", {
        Position = UDim2.fromOffset(10, 0),
        Size = UDim2.new(1, -18, 1, 0),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = C.red,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left
    }, box)

    local contents = new("Frame", {
        Position = UDim2.fromOffset(6, 41),
        Size = UDim2.new(1, -12, 0, 0),
        BackgroundColor3 = C.panel,
        AutomaticSize = Enum.AutomaticSize.Y
    }, box)
    corner(contents, 7)
    stroke(contents, Color3.fromRGB(70, 22, 35), 0.7)

    local list = new("UIListLayout", {
        Padding = UDim.new(0, 0),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, contents)

    new("UIPadding", {
        PaddingTop = UDim.new(0, 3),
        PaddingBottom = UDim.new(0, 3),
        PaddingLeft = UDim.new(0, 4),
        PaddingRight = UDim.new(0, 4)
    }, contents)

    local function resize()
        box.Size = UDim2.new(1, 0, 0, contents.AbsoluteSize.Y + 47)
    end
    contents:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
    task.defer(resize)

    return contents
end

local function toggle(parent, text, key)
    local row = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = true
    }, parent)

    new("TextLabel", {
        Position = UDim2.fromOffset(7, 0),
        Size = UDim2.new(1, -62, 1, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = C.white,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    }, row)

    local pill = new("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -5, 0.5, 0),
        Size = UDim2.fromOffset(38, 21),
        BackgroundColor3 = C.off
    }, row)
    corner(pill, 20)

    local dot = new("Frame", {
        Position = UDim2.fromOffset(3, 3),
        Size = UDim2.fromOffset(15, 15),
        BackgroundColor3 = C.white
    }, pill)
    corner(dot, 20)

    local function refresh()
        pill.BackgroundColor3 = cfg[key] and C.red or C.off
        dot.Position = cfg[key]
            and UDim2.new(1, -18, 0, 3)
            or UDim2.fromOffset(3, 3)
    end

    row.Activated:Connect(function()
        cfg[key] = not cfg[key]
        refresh()
    end)
    refresh()
end

local function slider(parent, text, key, min, max)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 58),
        BackgroundColor3 = C.panel
    }, parent)

    local label = new("TextLabel", {
        Position = UDim2.fromOffset(7, 2),
        Size = UDim2.new(1, -14, 0, 21),
        BackgroundTransparency = 1,
        TextColor3 = C.white,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left
    }, row)

    local track = new("TextButton", {
        Position = UDim2.new(0, 7, 0, 32),
        Size = UDim2.new(1, -14, 0, 13),
        BackgroundColor3 = Color3.fromRGB(55, 35, 43),
        Text = "",
        AutoButtonColor = true
    }, row)
    corner(track, 10)

    local fill = new("Frame", {
        Size = UDim2.new(0.5, 0, 1, 0),
        BackgroundColor3 = C.red
    }, track)
    corner(fill, 10)

    local dragging = true

    local function setFromX(x)
        local ratio = math.clamp(
            (x - track.AbsolutePosition.X) /
            math.max(track.AbsoluteSize.X, 1), 0, 1
        )
        cfg[key] = math.floor(min + ratio * (max - min) + 0.5)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        label.Text = text .. ": " .. cfg[key]
    end

    local function refresh()
        local ratio = (cfg[key] - min) / (max - min)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        label.Text = text .. ": " .. cfg[key]
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            setFromX(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)

    refresh()
end

