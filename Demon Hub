local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -4, 0, 24)
status.BackgroundTransparency = 1
status.Text = "Ready"
status.TextColor3 = RED
status.TextSize = 12
status.Parent = settingsPage

local function configAction(action)
    if configName.Text == "" then
        status.Text = "Digite o nome da config."
        return
    end

    status.Text = "Aguarde..."

    local ok, success, message, data = pcall(function()
        return remote:InvokeServer(action, configName.Text, S)
    end)

    if not ok then
        status.Text = "Erro de conexão."
        return
    end

    status.Text = message or "Concluído."

    if action == "Load" and success and type(data) == "table" then
        for key, value in pairs(data) do
            if S[key] ~= nil and type(S[key]) == type(value) then
                S[key] = value
            end
        end

        for _, render in pairs(controls) do
            render()
        end
    end
end

